# build outputs (regenerated by `make all`)
build/
# eval reports are per-run artifacts; keep the folder
evals/reports/*
!evals/reports/.gitkeep
# environments & secrets (the OpenRouter key lives outside the repo; never commit any .env)
.venv/
.env
.env.*
*.env
# caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
~$*
